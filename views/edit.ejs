<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Note</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background-color: #8ae28a; }
        input, textarea { display: block; width: 800px; height: 300px; margin-bottom: 10px; padding: 8px; background-color: #b6ecb4; border: 1px solid #011b05; border-radius: 4px; box-sizing: border-box; }
        button { padding: 8px 12px; cursor: pointer; background-color: #9aec3c;  }
        .delete-button { background-color: #7e0303; color: white; border: none; margin-top: 15px; }
    </style>
</head>
<body>
    <h1>Edit Note</h1>

    <form action="/update-note/<%= note.id %>?_method=PUT" method="POST">
        <label for="name">Name:</label>
        <input class="title-input" id="name" type="text" name="name" value="<%= note.name %>" required>

        <label for="title">Title:</label>
        <input class="title-input" id="title" type="text" name="title" value="<%= note.title %>" required>

        <label for="content">Content:</label>
        <textarea id="content" name="content" required><%= note.content %></textarea>

        <button class="save-button" type="submit">Save Changes</button>
    </form>
    <style>
        .title-input{
            width: 400px;
            height: auto;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #011b05;
            border-radius: 4px;
        }
        .save-button {
            color: rgb(0, 0, 0);
            border: 1px solid #021a0c;
            padding: 10px 15px;
            cursor: pointer;
            border-radius: 4px;
        }
        .save-button:hover {
            background-color: #079643;
        }
    </style>

    <form action="/delete-note/<%= note.id %>?_method=DELETE" method="POST">
        <button class="delete-button" type="submit"
                onclick="return confirm('Are you sure you want to delete this note?')">
            Delete Note
        </button>
        <style>
            .delete-button {
                background-color: #7e0303;
                color: white;
                border: 1px solid #021a0c;
                padding: 10px 15px;
                cursor: pointer;
                border-radius: 4px;
            }
            .delete-button:hover {
                background-color: #5a0202;
            }
        </style>
    </form>

    <a href="/" style = "display:inline-block; margin-top: 15px;">Cancel</a>
</body>
</html>