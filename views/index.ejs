<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background-color: #8ae28a; }
        .form-container { background: rgb(12, 145, 8); padding: 20px; border-radius: 8px; max-width: 800px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        input, textarea { width: 100%; margin-bottom: 10px; padding: 8px; box-sizing: border-box; }
        button { background: #14662f; color: white; border: 2px solid #021a0c; padding: 10px 15px; cursor: pointer; border-radius: 4px; }
        button:hover { background: #034d22; }
        .recent-posts { max-width: 800px; margin-top: 30px; }
        .note-card { background: #c2ee91; min-height: 220px; box-shadow: 2px 2px 5px rgba(0,0,0,0.2); border-radius: 4px; }
        .note-title { margin-top: 0; }
        .note-meta { margin-bottom: 0; color: #28552d; font-size: 0.9rem; }
        .note-content { margin-top: 24px; }
        .edit-link { margin-top: auto; align-self: flex-end; padding-top: 20px; }
        .carousel-inner { padding: 0 42px; }
        .carousel-control-prev, .carousel-control-next {
            top: 50%;
            bottom: auto;
            width: 32px;
            height: 32px;
            transform: translateY(-50%);
            background: #14662f;
            border-radius: 50%;
            opacity: 1;
        }
        .carousel-control-prev-icon, .carousel-control-next-icon {
            width: 16px;
            height: 16px;
            filter: invert(1);
        }
    </style>
</head>
<body>
    <h1>📝Blogging It! </h1>
    <% if (currentUser) { %>
        <p>Signed in as <strong><%= currentUser.name %></strong>.</p>
        <form action="/logout" method="POST">
            <button type="submit" class="btn btn-secondary mb-3">Log out</button>
        </form>
    <% } else { %>
        <a href="/signup" class="btn btn-primary mb-3">Sign up</a>
        <a href="/login" class="btn btn-secondary mb-3">Log in</a>
    <% } %>

    <!-- Form to Submit a New Note -->
    <div class="form-container">
        <h3>Create a Post</h3>
        <form action="/add-note" method="POST">
            <input type="text" name="name" placeholder="Your Name" required>
            <input type="text" name="title" placeholder="Note Title" required>
            <textarea name="content" rows="4" placeholder="What would you like to say?" required></textarea>
            <button type="submit">Save Blog</button>
        </form>
    </div>

    <!-- Container to Display Existing Notes -->
    <h2>Recent Posts</h2>
    <div class="recent-posts">
        <% if (notesList.length === 0) { %>
            <p>No notes found. Create your first one above!</p>
        <% } else { %>
            <div id="recentPostsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000" data-bs-wrap="true">
                <div class="carousel-indicators">
                    <% notesList.forEach((note, index) => { %>
                        <button type="button" data-bs-target="#recentPostsCarousel" data-bs-slide-to="<%= index %>"
                            class="<%= index === 0 ? 'active' : '' %>"
                            aria-current="<%= index === 0 ? 'true' : 'false' %>"
                            aria-label="Show post <%= index + 1 %>"></button>
                    <% }) %>
                </div>

                <div class="carousel-inner">
                    <% notesList.forEach((note, index) => { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                            <article class="note-card px-5 pb-5 pt-2 d-flex flex-column">
                                <h4 class="note-title"><%= note.title %></h4>
                                <p class="note-meta">Posted by <%= note.name || 'Anonymous' %> on <%= note.createdAt ? new Date(note.createdAt).toLocaleString() : 'Unknown date' %></p>
                                <p class="note-content"><%= note.content %></p>
                                <% if (currentUser && note.creatorUserId === currentUser.user_id) { %>
                                    <a href="/edit-note/<%= note.id %>" class="edit-link">Edit</a>
                                <% } %>
                            </article>
                        </div>
                    <% }) %>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#recentPostsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous post</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#recentPostsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next post</span>
                </button>
            </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const carouselElement = document.getElementById('recentPostsCarousel');

            if (carouselElement) {
                bootstrap.Carousel.getOrCreateInstance(carouselElement, {
                    interval: 5000,
                    wrap: true
                }).cycle();
            }
        });
    </script>
</body>
</html>